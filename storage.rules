rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Validate image format and file size limit (10MB)
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /issues/{issueId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    match /resolutions/{issueId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && isValidImage();
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isValidImage();
    }
  }
}
